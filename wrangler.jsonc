{
	// Static-assets deployment for the Astro build output.
	// No Worker script, no KV, no sessions — just serve ./dist.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "peculiarengineer",
	"compatibility_date": "2025-06-01",
	"assets": {
		"directory": "./dist",
		// Serve dist/404.html for unknown paths. Workers static assets default to a
		// bare 404 with no body; Pages would have picked the file up on its own.
		"not_found_handling": "404-page"
	}
}
