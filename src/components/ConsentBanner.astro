<div id="consent-banner" class="term-panel" role="region" aria-label="Cookie consent" hidden>
	<span class="term-label">:: consent.sh ::</span>
	<div class="log">
		<div class="dim">PECOS COOKIE DAEMON v1.0</div>
		<div>Analytics cookies (Google Analytics)... <span id="consent-state" class="err">OFF</span></div>
		<div>
			<span class="hi">$ allow analytics?</span> Counts visits. Cookies are set only if you accept.
		</div>
	</div>
	<div class="actions">
		<button type="button" class="btn" id="consent-accept" aria-label="Accept">[ ACCEPT ]</button>
		<button type="button" class="btn btn-dim" id="consent-decline" aria-label="Decline">[ DECLINE ]</button>
		<span class="cursor-blink" aria-hidden="true"></span>
	</div>
</div>

<script is:inline>
	(function () {
		var banner = document.getElementById('consent-banner');
		var KEY = 'pe-consent';
		function read() {
			try { return localStorage.getItem(KEY); } catch (e) { return null; }
		}
		function save(v) {
			try { localStorage.setItem(KEY, v); } catch (e) {}
		}
		function set(v) {
			save(v);
			if (v === 'granted') {
				if (window.peLoadAnalytics) window.peLoadAnalytics();
			} else if (window.peAnalyticsLoaded) {
				// gtag.js is already running on this page: drop its cookies and start clean
				document.cookie.split(';').forEach(function (c) {
					var n = c.split('=')[0].trim();
					if (n === '_ga' || n.indexOf('_ga_') === 0) {
						document.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
					}
				});
				location.reload();
				return;
			}
			banner.hidden = true;
		}
		var state = document.getElementById('consent-state');
		function show() {
			var on = read() === 'granted';
			state.textContent = on ? 'ON' : 'OFF';
			state.className = on ? 'hi' : 'err';
			banner.hidden = false;
		}
		if (!read()) show();
		document.getElementById('consent-accept').addEventListener('click', function () { set('granted'); });
		document.getElementById('consent-decline').addEventListener('click', function () { set('denied'); });
		document.addEventListener('click', function (e) {
			if (e.target && e.target.closest && e.target.closest('[data-consent-reopen]')) show();
		});
	})();
</script>

<style>
	#consent-banner {
		position: fixed;
		left: 1em;
		right: 1em;
		bottom: 1em;
		max-width: 640px;
		margin: 0 auto;
		z-index: 1000;
		padding: 1.25em 1.25em 1em;
		background: var(--sys-bg);
		color: var(--sys-text);
		box-shadow: 0 0 18px rgba(var(--sys-fg-rgb), 0.25);
		font-size: 0.85em;
		line-height: 1.5;
	}
	#consent-banner[hidden] {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		#consent-banner:not([hidden]) {
			animation: boot 0.3s steps(4, end) both;
		}
	}
	@keyframes boot {
		0% { opacity: 0; transform: translateY(8px); }
		100% { opacity: 1; transform: none; }
	}
	.log {
		color: var(--sys-dim);
	}
	.dim {
		color: var(--sys-dim);
	}
	.hi {
		color: var(--sys-fg);
		font-weight: 700;
	}
	.err {
		color: #f2837a;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75em;
		margin-top: 1em;
	}
	.btn {
		font: inherit;
		cursor: pointer;
		padding: 0.4em 0.9em;
		text-transform: uppercase;
		font-weight: 700;
		background: transparent;
		border: 1px solid var(--sys-fg);
		color: var(--sys-fg);
	}
	.btn-dim {
		border-color: var(--sys-dim);
		color: var(--sys-dim);
		font-weight: 400;
	}
	.btn:hover,
	.btn-dim:hover,
	.btn:focus-visible {
		border-color: var(--sys-fg);
		background: var(--sys-fg);
		color: var(--sys-bg);
	}
	.btn:focus-visible {
		outline: 2px solid var(--sys-fg);
		outline-offset: 3px;
	}
</style>
