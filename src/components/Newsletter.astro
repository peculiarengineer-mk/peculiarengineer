---
import { NEWSLETTER_ACTION, NEWSLETTER_ENABLED, NEWSLETTER_READY } from '../consts';

interface Props {
	/** Buttondown tag recording where the subscriber signed up, for segmenting sends. */
	tag?: string;
	heading?: string;
	blurb?: string;
	cta?: string;
	/** Small inline form for post footers vs. the fuller panel used on landing pages. */
	compact?: boolean;
}

const {
	tag = 'blog',
	heading = 'Subscribe',
	blurb = "One email every Sunday with the week's new posts: Linux, Kubernetes, Cloudflare, and whatever broke. No spam, one click to unsubscribe.",
	cta = 'Subscribe >',
	compact = false,
} = Astro.props;

// Buttondown scopes its embed by username, so the id must be unique per form
// on the page or the <label for> binding silently points at the wrong input.
const inputId = `bd-email-${tag}`;
---

{
	NEWSLETTER_ENABLED && (
		<div class:list={['term-panel', 'newsletter', { compact }]}>
			<span class="term-label">:: {heading} ::</span>
			<p class="prompt" aria-hidden="true"><span class="ps1">$</span> <span class="cmd">subscribe --weekly</span><span class="cursor"></span></p>
			<p class="blurb">{blurb}</p>
			{NEWSLETTER_READY ? (
				<>
					<form action={NEWSLETTER_ACTION} method="post" target="popupwindow">
						<label class="sr-only" for={inputId}>
							Email address
						</label>
						<input
							type="email"
							name="email"
							id={inputId}
							placeholder="you@example.com"
							required
							autocomplete="email"
						/>
						<input type="hidden" name="tag" value={tag} />
						<button type="submit">{cta}</button>
					</form>
					<p class="privacy">Email only, stored by Buttondown. Unsubscribe any time.</p>
					<p class="status" role="status"></p>
				</>
			) : (
				<p class="setup-warning">
					<strong>Not wired up yet.</strong> Set <code>BUTTONDOWN_USERNAME</code> in{' '}
					<code>src/consts.ts</code> before deploying.
				</p>
			)}
		</div>
	)
}

<script>
	// Typing effect and submit receipt for the newsletter panels. With Reduce
	// Motion on the prompt shows in full and the receipt appears all at once.
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduce) {
		// Hide the command until the panel scrolls into view, then type it in,
		// once per panel. Without this script the command just shows in full.
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.replace('armed', 'animate');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.4 }
		);
		document.querySelectorAll('.newsletter').forEach((panel) => {
			panel.classList.add('armed');
			observer.observe(panel);
		});
	}

	// The submit is only watched, never stopped: the POST to the popup window
	// has to happen. Print the receipt lines in the panel's status line.
	document.querySelectorAll('.newsletter form').forEach((form) => {
		form.addEventListener('submit', () => {
			const status = form.closest('.newsletter')?.querySelector('.status');
			if (!status) return;
			const lines = ['> POST buttondown.com ... [ OK ]', '> check your inbox to confirm'];
			if (reduce) {
				status.textContent = lines.join('\n');
				return;
			}
			status.textContent = '';
			lines.forEach((_, i) =>
				setTimeout(() => {
					status.textContent = lines.slice(0, i + 1).join('\n');
				}, i * 400)
			);
		});
	});
</script>

<style>
	.newsletter {
		margin: 2.5em 0;
	}
	.newsletter.compact {
		margin: 3em 0 1em;
	}
	.blurb {
		margin: 0 0 1em;
		color: var(--sys-text);
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
	.newsletter.compact .blurb {
		font-size: 0.85em;
	}
	form {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
	}
	input[type='email'] {
		flex: 1 1 16em;
		padding: 0.6em 0.75em;
	}
	button {
		font-family: var(--font-mono);
		font-size: 16px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.6em 1.2em;
		background: var(--sys-bg);
		color: var(--sys-fg);
		border: 1px solid var(--sys-fg);
		cursor: pointer;
	}
	button:hover {
		background: var(--sys-fg);
		color: var(--sys-bg);
	}
	.setup-warning {
		margin: 0;
		color: var(--sys-fg);
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
	.privacy {
		margin: 0.75em 0 0;
		color: var(--sys-dim);
		font-family: var(--font-mono);
		font-size: 0.75em;
	}
	.prompt {
		margin: 0 0 0.75em;
		font-family: var(--font-mono);
		font-size: 0.9em;
	}
	.ps1 {
		color: var(--sys-dim);
	}
	.cmd {
		color: var(--sys-fg);
		display: inline-block;
		vertical-align: bottom;
		white-space: nowrap;
		overflow: hidden;
	}
	.armed .cmd {
		width: 0;
	}
	.animate .cmd {
		animation: type 1.2s steps(18);
	}
	@keyframes type {
		from {
			width: 0;
		}
		to {
			width: 18ch;
		}
	}
	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.1em;
		margin-left: 0.15em;
		vertical-align: bottom;
		background: var(--sys-fg);
		animation: blink 1s steps(1) infinite;
	}
	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}
	.status {
		margin: 0.75em 0 0;
		color: var(--sys-dim);
		font-family: var(--font-mono);
		font-size: 0.85em;
		white-space: pre-line;
	}
	.status:empty {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor,
		.animate .cmd {
			animation: none;
		}
	}
</style>
