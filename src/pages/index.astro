---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, sortByPubDate } from '../consts';
import { DEEP_DIVES, PATHS, POPULAR, TOPICS, postsForTopic, resolveSlugs } from '../curation';

const posts = (await getCollection('blog')).sort(sortByPubDate);
const latest = posts[0];
const paths = PATHS.map((path) => ({ ...path, entries: resolveSlugs(posts, path.posts) }));
const popular = resolveSlugs(posts, POPULAR);
const deepDives = resolveSlugs(posts, DEEP_DIVES);
const topics = TOPICS.map((topic) => ({
	topic,
	count: postsForTopic(posts, topic.slug).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — Linux, Cloudflare, DevOps & AI how-tos`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- BIOS boot sequence -->
			<div class="bios">
				PECOS BIOS v4.2.1-RELEASE<br />
				Copyright (C) 1989-{new Date().getFullYear()}, Peculiar Engineering Systems<br />
				<br />
				CPU: ThoughtProcessor(tm) 8-Core @ 3.4GHz<br />
				Memory Test: 640K OK<br />
				Initializing Subsystems... OK<br />
				Mounting Filesystem (/dev/hda1)... OK<br />
				Loading Mission Protocol: <span class="hi">A QUIET PLACE FOR RIGOROUS THINKING.</span><br />
				<br />
				System Ready.<span class="cursor-blink"></span>
			</div>

			<!-- Hero -->
			<section class="term-panel hero">
				<span class="term-label">:: Peculiar_Engineer.exe ::</span>
				<h1>&gt; Peculiar Engineer_</h1>
				<p>
					Tested Linux, DevOps and AI guides, with the real commands, the real errors, and the fixes that worked.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="/blog">[ RUN: Read_Blog ]</a>
					<a class="btn btn-dim" href="/about">[ INFO: About_Author ]</a>
				</div>
			</section>

			<!-- Bento grid -->
			<section class="bento">
				{
					latest && (
						<a class="card card-latest" href={`/blog/${latest.id}/`}>
							<span class="card-tag">MODULE 01</span>
							<div>
								<span class="badge">Latest Deep Dive</span>
								<h2>{latest.data.title}</h2>
								<p class="excerpt">{latest.data.description}</p>
								<p class="meta">
									<FormattedDate date={latest.data.pubDate} />
								</p>
							</div>
							<div class="card-exec">EXECUTE_READ --&gt;</div>
						</a>
					)
				}

				{
					posts[1] ? (
						<a class="card card-latest" href={`/blog/${posts[1].id}/`}>
							<span class="card-tag">MODULE 02</span>
							<div>
								<span class="badge">Recent Entry</span>
								<h2>{posts[1].data.title}</h2>
								<p class="excerpt">{posts[1].data.description}</p>
								<p class="meta">
									<FormattedDate date={posts[1].data.pubDate} />
								</p>
							</div>
							<div class="card-exec">EXECUTE_READ --&gt;</div>
						</a>
					) : (
						<div class="card card-code">
							<span class="card-tag">MODULE 02</span>
							<div class="code-head">
								<span class="code-cmd">~/$ cat deploy.sh</span>
							</div>
							<pre><code>#!/bin/bash
set -euo pipefail

# Ensure deterministic builds
export DOCKER_BUILDKIT=1
docker build \
  --build-arg VERSION=$(git rev-parse HEAD) \
  -t peculiar/engine:latest .</code></pre>
						</div>
					)
				}

				<div class="quick-links">
					<a href="/blog"><span class="hex">0x01</span><h3>Documentation</h3></a>
					<a href="/experiments"><span class="hex">0x02</span><h3>Experiments</h3></a>
					<a href="/rss.xml"><span class="hex">0x03</span><h3>RSS Feed</h3></a>
				</div>
			</section>

			{'\n'}
			<!-- Start here -->
			<section class="term-panel">
				<span class="term-label">:: start_here.sh ::</span>
				<h2>Start here</h2>
				<div class="path-grid">
					{
						paths.map((path) => (
							<div class="path">
								<h3>{path.title}</h3>
								<p class="path-blurb">{path.blurb}</p>
								<ol>
									{path.entries.map((post) => (
										<li>
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</li>
									))}
								</ol>
							</div>
						))
					}
				</div>
			</section>

			{'\n'}
			<!-- Popular fixes -->
			<section class="term-panel">
				<span class="term-label">:: popular_fixes.log ::</span>
				<h2>Popular fixes</h2>
				<ul class="compact">
					{
						popular.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))
					}
				</ul>
			</section>

			{'\n'}
			<!-- Browse by topic -->
			<section class="term-panel">
				<span class="term-label">:: topics/ ::</span>
				<h2>Browse by topic</h2>
				<nav class="topic-chips" aria-label="Browse by topic">
					{
						topics.map(({ topic, count }) => (
							<>
								{'\n'}
								<a href={`/topics/${topic.slug}/`}>#{topic.label} ({count})</a>
							</>
						))
					}
					{'\n'}
					<a href="/topics/">all topics</a>
				</nav>
			</section>

			{'\n'}
			<!-- Deep dives -->
			<section class="term-panel">
				<span class="term-label">:: deep_dives/ ::</span>
				<h2>Deep dives</h2>
				<ul class="compact">
					{
						deepDives.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>{' '}
								<span class="dive-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</li>
						))
					}
				</ul>
			</section>

			<div class="rule">
				+--------------------------------------------------------------------------+
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: 2em;
	}
	/* BIOS */
	.bios {
		color: var(--sys-dim);
		font-size: 0.8em;
		line-height: 1.5;
	}
	.bios .hi {
		color: var(--sys-fg);
		font-weight: 700;
	}

	/* Hero */
	.hero h1 {
		font-size: 2.4em;
		margin: 0.2em 0 0.4em;
	}
	.hero p {
		max-width: 60ch;
		color: var(--sys-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
		margin-top: 1.5em;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.5em 1em;
		text-transform: uppercase;
		font-weight: 700;
		text-decoration: none;
		border: 1px solid var(--sys-fg);
		color: var(--sys-fg);
	}
	.btn:hover {
		background: var(--sys-fg);
		color: var(--sys-bg);
	}
	.btn-dim {
		border-color: var(--sys-dim);
		color: var(--sys-dim);
		font-weight: 400;
	}
	.btn-dim:hover {
		border-color: var(--sys-fg);
		background: var(--sys-fg);
		color: var(--sys-bg);
	}

	/* Bento grid */
	.bento {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5em;
	}
	.card {
		position: relative;
		border: 1px solid var(--sys-fg);
		padding: 1.5em;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.card-tag {
		position: absolute;
		top: -0.7em;
		right: 1em;
		background: var(--sys-bg);
		padding: 0 0.5em;
		color: var(--sys-dim);
		text-transform: uppercase;
		font-size: 0.7em;
	}
	/* Latest post card */
	.card-latest {
		text-decoration: none;
		color: var(--sys-fg);
		gap: 1.5em;
	}
	.card-latest:hover {
		background: var(--sys-fg);
		color: var(--sys-bg);
	}
	.card-latest:hover .badge {
		border-color: var(--sys-bg);
		color: var(--sys-bg);
	}
	.card-latest:hover h2,
	.card-latest:hover .excerpt,
	.card-latest:hover .meta {
		color: var(--sys-bg);
	}
	.badge {
		display: inline-block;
		border: 1px solid var(--sys-fg);
		padding: 0.2em 0.5em;
		text-transform: uppercase;
		font-size: 0.7em;
		margin-bottom: 0.8em;
	}
	.card-latest h2 {
		font-size: 1.3em;
		text-decoration: underline;
		text-underline-offset: 4px;
		margin: 0 0 0.5em;
	}
	.excerpt {
		font-size: 0.9em;
		color: var(--sys-text);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.meta {
		font-size: 0.8em;
		color: var(--sys-dim);
		margin: 0.5em 0 0;
	}
	.card-exec {
		text-transform: uppercase;
		font-weight: 700;
	}

	/* Code card */
	.code-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--sys-dim);
		padding-bottom: 0.5em;
		margin-bottom: 1em;
	}
	.code-cmd {
		text-transform: uppercase;
		font-weight: 700;
		font-size: 0.85em;
	}
	.card-code pre {
		margin: 0;
		border: none;
		padding: 0;
		background: transparent !important;
		font-size: 0.8em;
	}

	/* Quick links */
	.quick-links {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
	}
	.quick-links a {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 1.2em;
		border: 1px solid var(--sys-dim);
		text-decoration: none;
		color: var(--sys-fg);
		text-transform: uppercase;
	}
	.quick-links a:hover {
		border-color: var(--sys-fg);
		background: var(--sys-fg);
		color: var(--sys-bg);
	}
	.quick-links .hex {
		position: absolute;
		top: 0.4em;
		left: 0.5em;
		font-size: 0.6em;
		color: var(--sys-dim);
	}
	.quick-links a:hover .hex,
	.quick-links a:hover h3 {
		color: var(--sys-bg);
	}
	.quick-links h3 {
		margin: 0;
		font-size: 1.05em;
	}

	/* Curated sections */
	.path-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5em;
	}
	.path h3 {
		margin: 0 0 0.3em;
	}
	.path-blurb {
		margin: 0 0 0.8em;
		font-size: 0.9em;
		color: var(--sys-text);
	}
	.path ol {
		margin: 0;
		padding-left: 1.4em;
		font-size: 0.9em;
	}
	.path ol li {
		margin-bottom: 0.5em;
	}
	.path ol a,
	.compact a {
		color: var(--sys-fg);
		text-decoration: none;
	}
	.path ol a:hover,
	.compact a:hover {
		background: var(--sys-fg);
		color: var(--sys-bg);
		text-decoration: none;
	}
	.compact {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.95em;
	}
	.compact li {
		margin-bottom: 0.6em;
	}
	.dive-date {
		margin-left: 0.8em;
		font-size: 0.8em;
		color: var(--sys-dim);
		white-space: nowrap;
	}
	.topic-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
	}
	.topic-chips a {
		border: 1px solid var(--sys-dim);
		padding: 0.25em 0.7em;
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--sys-fg);
		text-decoration: none;
		white-space: nowrap;
	}
	.topic-chips a:hover {
		background: var(--sys-fg);
		color: var(--sys-bg);
		text-decoration: none;
	}

	.rule {
		color: var(--sys-dim);
		overflow: hidden;
		white-space: nowrap;
		font-size: 0.75em;
	}

	@media (max-width: 720px) {
		.bento,
		.quick-links,
		.path-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
