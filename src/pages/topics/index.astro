---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { TOPICS, postsForTopic } from '../../curation';
import { SITE_TITLE } from '../../consts';
import '../../styles/listing.css';

const posts = await getCollection('blog');
const topics = TOPICS.map((topic) => ({
	topic,
	count: postsForTopic(posts, topic.slug).length,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Topics · ${SITE_TITLE}`}
			description="Browse every guide by topic: Ubuntu, Docker, SSH, security, self-hosting, AI and Kubernetes."
		/>
		<style>
			.listing li a {
				position: relative;
				display: block;
				border: 1px solid var(--sys-dim);
				padding: 1.25em 1.5em;
				text-decoration: none;
				color: var(--sys-fg);
			}
			.listing li a:hover {
				border-color: var(--sys-fg);
				background: transparent;
			}
			.listing li a:hover .title {
				text-decoration: underline;
				text-underline-offset: 4px;
			}
			.title {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0 0.6em;
			}
			.title .count {
				color: var(--sys-dim);
				font-size: 0.7em;
				font-weight: normal;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="listing">
				<h1 class="listing-head">
					~/$ ls /topics &nbsp;&middot;&nbsp; <span class="count">{topics.length}</span> entr{topics.length === 1 ? 'y' : 'ies'} found
				</h1>
				<ul>
					{
						topics.map(({ topic, count }) => (
							<li>
								<a href={`/topics/${topic.slug}/`}>
									<h2 class="title">
										{topic.label} <span class="count">{count} posts</span>
									</h2>
									{topic.blurb && <p class="desc">{topic.blurb}</p>}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
