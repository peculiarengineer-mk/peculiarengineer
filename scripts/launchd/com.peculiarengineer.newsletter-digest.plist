<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for the weekly newsletter digest: every Sunday at 07:00
  it builds the draft from the week's posts and leaves it in Buttondown for
  Keith to add his lines and send.

  __REPO__ and __NODE__ below are literal placeholders. The installer replaces
  __REPO__ with the repo path and __NODE__ with the node binary, then loads the
  agent. After copying this file into ~/Library/LaunchAgents/:

    sed -i '' -e 's|__REPO__|/path/to/peculiarengineer|g' -e 's|__NODE__|/usr/local/bin/node|g' ~/Library/LaunchAgents/com.peculiarengineer.newsletter-digest.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.peculiarengineer.newsletter-digest.plist

  To stop it again: launchctl bootout gui/$(id -u)/com.peculiarengineer.newsletter-digest

  The buttondown.env file holds BUTTONDOWN_API_KEY and is sourced into the
  environment; without it the digest still writes the draft locally. Log output
  lands in __REPO__/newsletter/digest.log, which stays out of git.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.peculiarengineer.newsletter-digest</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>set -a; [ -f "$HOME/.config/peculiarengineer/buttondown.env" ] &amp;&amp; . "$HOME/.config/peculiarengineer/buttondown.env"; set +a; cd __REPO__ &amp;&amp; __NODE__ scripts/newsletter-digest.mjs --push</string>
	</array>
	<key>StandardOutPath</key>
	<string>__REPO__/newsletter/digest.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO__/newsletter/digest.log</string>
</dict>
</plist>
